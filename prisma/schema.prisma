generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PRO
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  role            UserRole  @default(USER)
  username        String?    @unique
  dateBirth       DateTime?  @map("date_birth") @db.Date
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  isDeleted       Boolean   @default(false) @map("is_deleted")

  planId Int  @map("plan_id")
  plan   Plan @relation(fields: [planId], references: [id])

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// CARDS

enum KycRequirement {
  REQUIRED
  NOT_REQUIRED
  UNKNOWN
}

model Country {
  code String @id @db.Char(2)
  name String

  companies CardCompany[]

  @@map("countries")
}

model CardCompany {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  description String?

  websiteUrl  String  @map("website_url")
  referralUrl String? @map("referral_url")
  logoUrl     String  @map("logo_url")

  kycRequirement KycRequirement @default(UNKNOWN) @map("kyc_requirement")

  virtualCard  Boolean @default(true) @map("virtual_card")
  physicalCard Boolean @default(false) @map("physical_card")

  applePay  Boolean @default(false) @map("apple_pay")
  googlePay Boolean @default(false) @map("google_pay")

  visaCard   Boolean @default(false) @map("visa_card")
  masterCard Boolean @default(false) @map("master_card")

  isActive Boolean @default(true) @map("is_active")

  countries Country[]

  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("card_companies")
}

// PLANS

model Plan {
  id          Int      @id @default(autoincrement())
  code        UserPlan @unique
  name        String
  description String
  priceCents  Int      @map("price_cents")

  features String[]

  mostPopular Boolean @default(false) @map("most_popular")

  users  User[]
  orders Order[]

  @@map("plans")
}

// ORDERS

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id          Int         @id @default(autoincrement())
  status      OrderStatus @default(PENDING)
  amountCents Int         @map("amount_cents")
  currency    String      @default("usd")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  planId Int  @map("plan_id")
  plan   Plan @relation(fields: [planId], references: [id])

  stripeCheckoutSessionId String? @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @unique @map("stripe_payment_intent_id")

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  @@index([userId])
  @@index([planId])
  @@map("orders")
}

model PrivacyPolicy {
  id      Int    @id @default(autoincrement())
  content String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("privacy_policy")
}

model TermsPolicy {
  id      Int    @id @default(autoincrement())
  content String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("terms_policy")
}
