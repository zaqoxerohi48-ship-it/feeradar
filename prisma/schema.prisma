generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PRO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  role         UserRole @default(USER)
  plan         UserPlan @default(FREE)

  emailVerifiedAt DateTime? @map("email_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// CARDS

enum KycRequirement {
  REQUIRED
  NOT_REQUIRED
  UNKNOWN
}

model Country {
  code String @id @db.Char(2)
  name String

  companies CardCompany[]

  @@map("countries")
}

model CardCompany {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  description String?

  websiteUrl  String  @map("website_url")
  referralUrl String? @map("referral_url")
  logoUrl     String  @map("logo_url")

  kycRequirement KycRequirement @default(UNKNOWN) @map("kyc_requirement")

  virtualCard  Boolean @default(true) @map("virtual_card")
  physicalCard Boolean @default(false) @map("physical_card")

  applePay  Boolean @default(false) @map("apple_pay")
  googlePay Boolean @default(false) @map("google_pay")

  visaCard   Boolean @default(false) @map("visa_card")
  masterCard Boolean @default(false) @map("master_card")

  isActive Boolean @default(true) @map("is_active")

  countries Country[]

  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("card_companies")
}

